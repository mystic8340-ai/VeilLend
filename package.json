{
  "name": "veillend",
  "private": true,
  "version": "1.0.0",
  "description": "VeilLend - Zero-Knowledge Private Lending Protocol on Midnight Network",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "lint": "tsc --noEmit",
    "preview": "vite preview",
